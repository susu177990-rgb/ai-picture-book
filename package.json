{
  "name": "ai-picture-book",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "desktop:start": "electron .",
    "desktop:clean": "node -e \"require('fs').rmSync('dist-electron', { recursive: true, force: true })\"",
    "desktop:build": "npm run desktop:clean && npm run build && electron-builder",
    "desktop:build:mac": "npm run desktop:clean && npm run build && electron-builder --mac dmg zip",
    "desktop:build:win": "npm run desktop:clean && npm run build && electron-builder --win nsis",
    "desktop:build:dir": "npm run desktop:clean && npm run build && electron-builder --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mohtasham/md-to-docx": "^2.9.0",
    "@tanstack/react-virtual": "^3.13.20",
    "fflate": "^0.8.2",
    "mammoth": "^1.11.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^9.0.1",
    "react-intersection-observer": "^10.0.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.4.2",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.openclaw.ai-picture-book",
    "productName": "AI儿童绘本生成器",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone/server.js",
        "to": "next-app/server.js",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "next-app/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/.next",
        "to": "next-app/.next",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/package.json",
        "to": "next-app/package.json",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "next-app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "next-app/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data",
        "to": "next-app/data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
